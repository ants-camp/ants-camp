          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="competition_id 추출" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
import groovy.json.JsonSlurper
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
def id = json?.data?.competitionId?.toString()
if (id) {
    vars.put(&quot;competition_id&quot;, id)
    props.put(&quot;competition_id&quot;, id)   // tearDown 에서 props 로 읽음
    log.info(&quot;[setUp-7] competition_id: &quot; + id)
} else {
    log.error(&quot;[setUp-7] 대회 생성 실패: &quot; + prev.getResponseDataAsString())
}
            </stringProp>
