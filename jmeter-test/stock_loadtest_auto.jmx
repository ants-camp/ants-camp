<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="주식 모의투자 전체 흐름 부하테스트 (자동 셋업)">
      <stringProp name="TestPlan.comments">
        setUp  : 대회 생성 → 게시 → 유저1~4 참가 → Kafka 대기 → 계좌 자동 수집 → 대회 시작
        main   : 스레드 번호로 유저 배정 → 로그인 → (현재가 조회 → 시장가 매수 → 매도) × TRADE_LOOPS
        tearDown: 대회 종료
        ※ users.csv 의 accountId 는 더 이상 사용 안 함. setUp 에서 동적 수집.
      </stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="전역 변수">
