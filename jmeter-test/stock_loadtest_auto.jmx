        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[0] 유저 배정 (스레드 번호 기반)">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
// ctx.getThreadNum() : 스레드 그룹 내 0-indexed 번호
int idx = (ctx.getThreadNum() % 4) + 1   // 1~4 순환

def email    = vars.get(&quot;USER&quot; + idx + &quot;_EMAIL&quot;)
def password = vars.get(&quot;USER&quot; + idx + &quot;_PASSWORD&quot;)
def accountId = props.get(&quot;account_id_&quot; + email) ?: &quot;ACCOUNT_NOT_FOUND&quot;

vars.put(&quot;email&quot;,     email)
vars.put(&quot;password&quot;,  password)
vars.put(&quot;accountId&quot;, accountId)

log.info(&quot;[main] Thread#&quot; + ctx.getThreadNum() + &quot; → USER&quot; + idx + &quot; (&quot; + email + &quot;) accountId=&quot; + accountId)
          </stringProp>
        </JSR223Sampler>
