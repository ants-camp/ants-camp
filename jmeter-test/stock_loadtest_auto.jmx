        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[setUp-1] 대회 시간 계산">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.text.SimpleDateFormat
def sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss&quot;)
def now = new Date()
def cal = Calendar.getInstance()

cal.setTime(now); cal.add(Calendar.MINUTE, 3)
vars.put(&quot;register_end_at&quot;, sdf.format(cal.getTime()))

cal.setTime(now); cal.add(Calendar.MINUTE, 4)
vars.put(&quot;competition_start_at&quot;, sdf.format(cal.getTime()))

def durationMin = (vars.get(&quot;COMPETITION_DURATION_MIN&quot;) ?: &quot;60&quot;) as Integer
cal.setTime(now); cal.add(Calendar.MINUTE, durationMin)
vars.put(&quot;competition_end_at&quot;, sdf.format(cal.getTime()))

log.info(&quot;[setUp-1] register_end_at:      &quot; + vars.get(&quot;register_end_at&quot;))
log.info(&quot;[setUp-1] competition_start_at: &quot; + vars.get(&quot;competition_start_at&quot;))
log.info(&quot;[setUp-1] competition_end_at:   &quot; + vars.get(&quot;competition_end_at&quot;))
          </stringProp>
        </JSR223Sampler>
        <hashTree/>
